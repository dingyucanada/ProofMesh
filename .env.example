# Copy to .env for local Docker review only. Replace every value with an
# independently generated secret. Never commit the resulting .env file.
PROOFMESH_ENV=development
# Optional read-only operations identity; it cannot create or advance cases.
PROOFMESH_OPERATOR_TOKEN=
PROOFMESH_ORCHESTRATOR_TOKEN=replace-with-random-orchestrator-token
PROOFMESH_APPROVER_TOKEN=replace-with-random-approver-token
PROOFMESH_AUDITOR_TOKEN=replace-with-random-auditor-token
PROOFMESH_INTAKE_TOKEN=replace-with-random-intake-token
PROOFMESH_INVESTIGATOR_TOKEN=replace-with-random-investigator-token
PROOFMESH_POLICY_TOKEN=replace-with-random-policy-token
PROOFMESH_EXECUTOR_TOKEN=replace-with-random-executor-token
PROOFMESH_VERIFIER_TOKEN=replace-with-random-verifier-token
PROOFMESH_MEMORY_TOKEN=replace-with-random-memory-token
PROOFMESH_GATEWAY_TOKEN=replace-with-random-gateway-token
PROOFMESH_OPERATOR_TENANTS=acme-cn
PROOFMESH_ORCHESTRATOR_TENANTS=acme-cn
PROOFMESH_APPROVER_TENANTS=acme-cn
PROOFMESH_AUDITOR_TENANTS=acme-cn

# External evaluation providers. Values belong only in a local secret manager
# or an uncommitted .env. Never paste a key into chat, logs, screenshots, or Git.
PROOFMESH_MODEL_PROVIDER=
PROOFMESH_MODEL_BASE_URL=
PROOFMESH_MODEL_NAME=
PROOFMESH_MODEL_API_KEY=
PROOFMESH_VENDOR_TENANT_ID=acme-cn
# Stripe test/restricted-test key only; live keys are rejected by the adapter.
PROOFMESH_STRIPE_SECRET_KEY=
PROOFMESH_HUBSPOT_ACCESS_TOKEN=
PROOFMESH_HUBSPOT_OPEN_STAGE_ID=
PROOFMESH_HUBSPOT_CLOSED_STAGE_ID=
PROOFMESH_VENDOR_TIMEOUT_SECONDS=3.0
# API base overrides are for loopback contract tests only. Non-official remote hosts are rejected.
# PROOFMESH_STRIPE_API_BASE=https://api.stripe.com
# PROOFMESH_HUBSPOT_API_BASE=https://api.hubapi.com
