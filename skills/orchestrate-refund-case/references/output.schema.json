{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofmesh.local/schemas/orchestrate-refund-case.output.json",
  "title": "ProofMeshCreateCaseSummary",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "project_id", "ticket_id", "tenant_id", "requester", "status", "revision", "created_at", "updated_at", "context_digest", "policy_digest", "plan_digest", "approval_required", "approval_scope", "approval_digest", "amount_minor", "currency", "risk_score", "last_step", "next_step", "final_message", "proof_bundle", "gateway_receipt_count", "task_receipt_count", "agent_count"],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^wf-[a-f0-9]{32}$"},
    "project_id": {"type": "string", "pattern": "^wf-[a-f0-9]{32}$"},
    "ticket_id": {"type": "string", "pattern": "^[A-Z0-9-]{3,64}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9-]{2,64}$"},
    "requester": {"type": "string", "minLength": 3, "maxLength": 128},
    "status": {"const": "RECEIVED"},
    "revision": {"const": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "context_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_digest": {"type": "null"},
    "approval_required": {"const": false},
    "approval_scope": {"type": "array", "maxItems": 0},
    "approval_digest": {"type": "null"},
    "amount_minor": {"type": "null"},
    "currency": {"type": "null"},
    "risk_score": {"type": "null"},
    "last_step": {"const": "create_case"},
    "next_step": {"const": "normalize_case"},
    "final_message": {"type": "string", "minLength": 1},
    "proof_bundle": {"type": "null"},
    "gateway_receipt_count": {"const": 0},
    "task_receipt_count": {"const": 1},
    "agent_count": {"const": 1}
  }
}
