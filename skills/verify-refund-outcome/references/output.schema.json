{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofmesh.local/schemas/verify-refund-outcome.output.json",
  "title": "ProofMeshVerifiedSummary",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "project_id", "ticket_id", "tenant_id", "requester", "status", "revision", "created_at", "updated_at", "context_digest", "policy_digest", "plan_digest", "approval_required", "approval_scope", "approval_digest", "amount_minor", "currency", "risk_score", "last_step", "next_step", "final_message", "proof_bundle", "gateway_receipt_count", "task_receipt_count", "agent_count"],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^wf-[a-f0-9]{32}$"},
    "project_id": {"type": "string", "pattern": "^wf-[a-f0-9]{32}$"},
    "ticket_id": {"type": "string", "pattern": "^[A-Z0-9-]{3,64}$"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9-]{2,64}$"},
    "requester": {"type": "string", "minLength": 3, "maxLength": 128},
    "status": {"enum": ["VERIFIED", "COMPENSATED", "BLOCKED"]},
    "revision": {"type": "integer", "minimum": 5},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "context_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approval_required": {"type": "boolean"},
    "approval_scope": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "approval_digest": {"oneOf": [{"const": "AUTOMATIC"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "amount_minor": {"type": "integer", "minimum": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
    "last_step": {"const": "verify_outcome"},
    "next_step": {"oneOf": [{"const": "curate_memory"}, {"type": "null"}]},
    "final_message": {"type": "string", "minLength": 1},
    "proof_bundle": {"type": "null"},
    "gateway_receipt_count": {"type": "integer", "minimum": 1},
    "task_receipt_count": {"type": "integer", "minimum": 6},
    "agent_count": {"type": "integer", "minimum": 1}
  }
}
