+func TestCreateTeamWithWorkerMembersTakesPrecedenceOverLegacyFields(t *testing.T) {
+	scheme := newServerTestScheme(t)
+	k8sClient := fake.NewClientBuilder().WithScheme(scheme).Build()
+	handler := NewResourceHandler(k8sClient, "default", nil, "")
+
+	body := []byte(`{
+		"name":"migration-team",
+		"workerMembers":[
+			{"name":"existing-leader","role":"team_leader"},
+			{"name":"existing-worker","role":"worker"}
+		],
+		"leader":{"name":"deprecated-leader"},
+		"workers":[{"name":"deprecated-worker"}]
+	}`)
+	req := httptest.NewRequest(http.MethodPost, "/api/v1/teams", bytes.NewReader(body))
+	rec := httptest.NewRecorder()
+	handler.CreateTeam(rec, req)
+
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("expected status %d, got %d: %s", http.StatusCreated, rec.Code, rec.Body.String())
+	}
+	var stored v1beta1.Team
+	if err := k8sClient.Get(context.Background(), client.ObjectKey{Name: "migration-team", Namespace: "default"}, &stored); err != nil {
+		t.Fatalf("get team: %v", err)
+	}
+	if len(stored.Spec.WorkerMembers) != 2 {
+		t.Fatalf("workerMembers len=%d, want 2", len(stored.Spec.WorkerMembers))
+	}
+	// The CRD/controller contract deliberately ignores deprecated inline fields
+	// whenever WorkerMembers is non-empty. Preserve them during REST transport so
+	// the existing migration semantics remain exactly where they are enforced.
+	if stored.Spec.Leader.Name != "deprecated-leader" || len(stored.Spec.Workers) != 1 {
+		t.Fatalf("legacy transport fields changed: leader=%q workers=%+v", stored.Spec.Leader.Name, stored.Spec.Workers)
+	}
+}
