+func TestCreateTeamWithWorkerMembersUsesDecoupledPath(t *testing.T) {
+	scheme := newServerTestScheme(t)
+	k8sClient := fake.NewClientBuilder().WithScheme(scheme).Build()
+	handler := NewResourceHandler(k8sClient, "default", nil, "")
+
+	body := []byte(`{
+		"name":"decoupled-team",
+		"workerMembers":[
+			{"name":"existing-leader","role":"team_leader"},
+			{"name":"existing-worker","role":"worker"}
+		]
+	}`)
+	req := httptest.NewRequest(http.MethodPost, "/api/v1/teams", bytes.NewReader(body))
+	rec := httptest.NewRecorder()
+	handler.CreateTeam(rec, req)
+
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("expected status %d, got %d: %s", http.StatusCreated, rec.Code, rec.Body.String())
+	}
+	var stored v1beta1.Team
+	if err := k8sClient.Get(context.Background(), client.ObjectKey{Name: "decoupled-team", Namespace: "default"}, &stored); err != nil {
+		t.Fatalf("get team: %v", err)
+	}
+	if len(stored.Spec.WorkerMembers) != 2 {
+		t.Fatalf("workerMembers len=%d, want 2", len(stored.Spec.WorkerMembers))
+	}
+	if stored.Spec.WorkerMembers[0].Name != "existing-leader" || stored.Spec.WorkerMembers[0].Role != "team_leader" {
+		t.Fatalf("unexpected leader ref: %+v", stored.Spec.WorkerMembers[0])
+	}
+	if stored.Spec.WorkerMembers[1].Name != "existing-worker" || stored.Spec.WorkerMembers[1].Role != "worker" {
+		t.Fatalf("unexpected worker ref: %+v", stored.Spec.WorkerMembers[1])
+	}
+	if stored.Spec.Leader.Name != "" || len(stored.Spec.Workers) != 0 {
+		t.Fatalf("decoupled create populated deprecated inline members: leader=%q workers=%+v", stored.Spec.Leader.Name, stored.Spec.Workers)
+	}
+}
